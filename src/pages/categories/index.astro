---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Category from "@/components/Category.astro";
import { getUniqueCategories } from "@/utils/getUniqueCategories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection(
  "posts",
  ({ data }) => !data.draft && (data.language ?? "en") === "en"
);
const categories = getUniqueCategories(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.categoriesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    <ul
      class="stagger m-0 grid list-none grid-cols-2 gap-3 p-0 sm:gap-4 lg:grid-cols-4"
    >
      {
        categories.map(({ category, categoryName, count }) => (
          <Category {category} {categoryName} {count} />
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
