---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Marquee from "@/components/ui/Marquee.astro";
import Hero from "@/components/home/Hero.astro";
import SelectedWork from "@/components/home/SelectedWork.astro";
import Research from "@/components/home/Research.astro";
import Writing from "@/components/home/Writing.astro";
import Contact from "@/components/home/Contact.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const RECENT_POSTS_COUNT = 6;

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection(
  "posts",
  ({ data }) => !data.draft && (data.language ?? "en") === "en"
);
const recentPosts = getSortedPosts(posts).slice(0, RECENT_POSTS_COUNT);
const homePath = getRelativeLocaleUrl(locale, "");

const tools = [
  "Python",
  "Go",
  "LangGraph",
  "vLLM",
  "Ray",
  "Kubernetes",
  "Qdrant",
  "PyTorch",
  "Transformers",
];

// Phone-only floating bar for jumping between home sections.
const quickNav = [
  { label: "Home", href: "#main-content" },
  { label: "Work", href: "#work" },
  { label: "Research", href: "#research" },
  { label: "Writing", href: "#writing" },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="wide-layout flex flex-col gap-14 pt-6 pb-10 sm:gap-20 sm:pt-10"
  >
    <Hero />
    <SelectedWork />
    <Research />
    {recentPosts.length > 0 && <Writing posts={recentPosts} />}
    <Marquee label="Tools I use" items={tools} />
    <Contact />
  </main>
  <Footer class="pb-20 sm:pb-0" />

  <nav
    aria-label="Sections"
    class="bg-ink fixed inset-x-0 bottom-4 z-40 mx-auto flex w-max gap-0.5 rounded-full p-1.5 text-[13px] shadow-[0_16px_32px_-16px_rgb(0_0_0/0.5)] sm:hidden"
  >
    {
      quickNav.map(item => (
        <a
          href={item.href}
          data-quick-nav
          class="text-ink-foreground aria-[current=true]:bg-signal aria-[current=true]:text-signal-foreground flex min-h-10 items-center rounded-full px-3.5 transition-colors aria-[current=true]:font-semibold"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    // Scroll-spy for the phone quick nav: highlight the section in view.
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-quick-nav]"),
    ];
    const setCurrent = (hash: string) =>
      links.forEach(a =>
        a.setAttribute("aria-current", String(a.hash === hash))
      );
    setCurrent("#main-content");
    const observer = new IntersectionObserver(
      entries => {
        const visible = entries.find(e => e.isIntersecting);
        if (visible) setCurrent(`#${visible.target.id}`);
      },
      { rootMargin: "-45% 0px -50% 0px" }
    );
    ["work", "research", "writing"].forEach(id => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
    const hero = document.getElementById("hero-title");
    if (hero)
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) setCurrent("#main-content");
      }).observe(hero);
  });
</script>
