---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const RECENT_POSTS_COUNT = 5;

const { site, socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection(
  "posts",
  ({ data }) => !data.draft && (data.language ?? "en") === "en"
);
const recentPosts = getSortedPosts(posts).slice(0, RECENT_POSTS_COUNT);
const homePath = getRelativeLocaleUrl(locale, "");

const publications = [
  {
    title:
      "BanLemma: A Word Formation Dependent Rule and Dictionary Based Bangla Lemmatizer",
    venue: "Findings of EMNLP 2023",
    url: "https://aclanthology.org/2023.findings-emnlp.241/",
  },
  {
    title:
      "BanNERD: A Benchmark Dataset and Context-Driven Approach for Bangla Named Entity Recognition",
    venue: "Findings of NAACL 2025",
    url: "https://aclanthology.org/2025.findings-naacl.388/",
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {site.author}
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="text-accent text-lg font-medium">
        Sr. AI Engineer &amp; Team Lead @ Delineate (YC W25)
      </p>

      <p class="mt-4 max-w-2xl">
        I lead a 10+ person AI team building production LLM and agentic
        systems for pharmaceutical research at
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href="https://delineate.pro/"
          target="_blank"
        >
          Delineate
        </LinkButton> (YC W25) — shipping multi-agent pipelines, scientific
        document extraction services, and evaluation systems that have to be
        right, not just convincing. 5+ years of experience in NLP, ML, and AI
        engineering, with publications at EMNLP 2023 and NAACL 2025.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section
      id="publications"
      class:list={[
        "pt-12 pb-6",
        { "border-border border-b": recentPosts.length > 0 },
      ]}
    >
      <h2 class="text-2xl font-semibold tracking-wide">Publications</h2>
      <ul>
        {
          publications.map(pub => (
            <li class="my-6">
              <a
                href={pub.url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "text-accent inline-block text-lg font-medium",
                  "decoration-dashed underline-offset-4 hover:underline",
                  "focus-visible:no-underline focus-visible:underline-offset-0",
                ]}
              >
                {pub.title}
              </a>
              <p class="text-muted-foreground">{pub.venue}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "blogs")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
