---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyAll } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);
const postCount = (tag: string) =>
  posts.filter(({ data }) => slugifyAll(data.tags).includes(tag)).length;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header wide />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <ul
      class="bg-surface border-border rounded-tile-sm sm:rounded-tile animate-rise m-0 flex list-none flex-wrap gap-2 border p-5 sm:p-7"
    >
      {
        tags.map(({ tag, tagName }) => (
          <Tag {tag} {tagName} count={postCount(tag)} />
        ))
      }
    </ul>
  </Main>

  <Footer wide />
</Layout>
