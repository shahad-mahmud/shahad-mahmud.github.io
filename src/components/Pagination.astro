---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);

const pill =
  "inline-flex min-h-11 items-center gap-1.5 rounded-full border px-5 text-sm font-medium";
---

{
  page.lastPage > 1 && (
    <nav
      class="wide-layout mt-auto mb-10 flex items-center justify-center gap-3"
      aria-label="Pagination Navigation"
    >
      {page.url.prev ? (
        <a
          href={page.url.prev}
          class:list={[pill, "bg-surface border-border hover:border-foreground/40"]}
          aria-label={t.a11y.goToPreviousPage}
        >
          <IconArrowLeft class="size-4 rtl:rotate-180" />
          {t.pagination.prev}
        </a>
      ) : (
        <span
          class:list={[pill, "border-border text-muted-foreground opacity-50"]}
          aria-disabled="true"
        >
          <IconArrowLeft class="size-4 rtl:rotate-180" />
          {t.pagination.prev}
        </span>
      )}
      <span class="text-muted-foreground font-mono text-xs">
        {page.currentPage} / {page.lastPage}
      </span>
      {page.url.next ? (
        <a
          href={page.url.next}
          class:list={[pill, "bg-ink text-ink-foreground border-ink"]}
          aria-label={t.a11y.goToNextPage}
        >
          {t.pagination.next}
          <IconArrowRight class="size-4 rtl:rotate-180" />
        </a>
      ) : (
        <span
          class:list={[pill, "border-border text-muted-foreground opacity-50"]}
          aria-disabled="true"
        >
          {t.pagination.next}
          <IconArrowRight class="size-4 rtl:rotate-180" />
        </span>
      )}
    </nav>
  )
}
