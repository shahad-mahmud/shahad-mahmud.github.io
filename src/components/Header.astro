---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  /** Match the wider bento container (home, posts) instead of app-layout. */
  wide?: boolean;
};

const { wide = false } = Astro.props;

const { features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navItems = [
  { label: t.nav.home, path: "/", href: getRelativeLocaleUrl(locale, "") },
  {
    label: t.nav.blogs,
    path: "/blogs",
    href: getRelativeLocaleUrl(locale, "blogs"),
  },
  {
    label: t.nav.tags,
    path: "/tags",
    href: getRelativeLocaleUrl(locale, "tags/"),
  },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-surface text-accent absolute inset-s-16 -top-full z-50 rounded-full px-4 py-2 transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class:list={[
    wide ? "wide-layout" : "app-layout",
    "flex items-center justify-between gap-4 pt-5 pb-2 sm:pt-6",
  ]}
>
  <a
    href={getRelativeLocaleUrl(locale, "")}
    class="font-display text-[22px] font-extrabold tracking-[-0.03em]"
    aria-label="Shahad Mahmud — home"
  >
    shahad<span class="text-signal">.</span>
  </a>

  <div class="flex items-center gap-2">
    <nav aria-label="Primary" class="hidden sm:block">
      <ul
        class="bg-surface border-border flex gap-0.5 rounded-full border p-1 text-sm"
      >
        {
          navItems.map(item => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.path) ? "page" : undefined}
                class:list={[
                  "block rounded-full px-4 py-2.5 transition-colors",
                  isActive(item.path)
                    ? "bg-ink text-ink-foreground"
                    : "text-muted-foreground hover:text-foreground",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      features.lightAndDarkMode && (
        <button
          id="theme-btn"
          class="bg-surface border-border text-foreground relative size-11 rounded-full border"
          title={t.a11y.toggleTheme}
          aria-label="auto"
          aria-live="polite"
        >
          <IconMoon class="absolute top-1/2 left-1/2 size-5 translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
          <IconSunHigh class="absolute top-1/2 left-1/2 size-5 translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
        </button>
      )
    }

    <button
      id="menu-btn"
      class="bg-ink text-ink-foreground flex size-11 items-center justify-center rounded-full sm:hidden"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="menu-sheet"
    >
      <IconMenuDeep class="size-5" />
    </button>
  </div>
</header>

<!-- Mobile menu: full-screen ink sheet with big display links. -->
<div
  id="menu-sheet"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  class="bg-ink text-ink-foreground fixed inset-0 z-50 hidden flex-col justify-between px-4 pt-5 pb-6 sm:hidden"
>
  <div class="flex items-center justify-between">
    <span class="font-display text-[22px] font-extrabold tracking-[-0.03em]">
      shahad<span class="text-signal">.</span>
    </span>
    <button
      id="menu-close"
      class="border-ink-muted flex size-11 items-center justify-center rounded-full border"
      aria-label={t.a11y.closeMenu}
    >
      <IconX class="size-5" />
    </button>
  </div>
  <nav aria-label="Primary">
    <ul>
      {
        navItems.map((item, i) => (
          <li class="border-ink-muted/60 border-b last:border-b-0">
            <a
              href={item.href}
              aria-current={isActive(item.path) ? "page" : undefined}
              class="font-display flex items-baseline justify-between py-3.5 text-[2.75rem] font-extrabold tracking-[-0.04em]"
            >
              {item.label}
              <span class="text-ink-muted font-mono text-xs font-normal tracking-normal">
                0{i}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a
    href="mailto:shahad9381@gmail.com"
    class="bg-signal text-signal-foreground flex min-h-14 items-center justify-center rounded-full font-semibold"
  >
    Get in touch ↗
  </a>
</div>

<script>
  function setupMenu() {
    const openBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const closeBtn = document.querySelector<HTMLButtonElement>("#menu-close");
    const sheet = document.querySelector<HTMLElement>("#menu-sheet");
    if (!openBtn || !closeBtn || !sheet) return;

    const setOpen = (open: boolean) => {
      sheet.classList.toggle("hidden", !open);
      sheet.classList.toggle("flex", open);
      openBtn.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
      (open ? closeBtn : openBtn).focus();
    };

    openBtn.addEventListener("click", () => setOpen(true));
    closeBtn.addEventListener("click", () => setOpen(false));
    sheet.addEventListener("keydown", e => {
      if (e.key === "Escape") setOpen(false);
    });
    // In-page anchors keep the page, so close the sheet on any link click.
    sheet
      .querySelectorAll("a")
      .forEach(a => a.addEventListener("click", () => setOpen(false)));
  }

  setupMenu();

  document.addEventListener("astro:after-swap", setupMenu);
</script>
