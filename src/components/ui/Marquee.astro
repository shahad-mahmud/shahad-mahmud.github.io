---
/**
 * Infinite horizontal strip of words (tools, skills). The list is rendered
 * twice so the loop is seamless; the copy is hidden from screen readers.
 */
type Props = { items: string[]; label: string; class?: string };

const { items, label, class: className } = Astro.props;

---

<section
  aria-label={label}
  class:list={[
    "marquee-wrap border-border overflow-hidden border-y py-3 sm:py-4",
    className,
  ]}
>
  <div
    class="marquee font-display gap-3 text-[1.375rem] font-bold tracking-[-0.02em] sm:text-[1.75rem]"
  >
    {
      [false, true].map(copy =>
        items.map(item => (
          <>
            <span aria-hidden={copy ? "true" : undefined}>{item}</span>
            <span aria-hidden="true" class="text-signal">
              ✦
            </span>
          </>
        ))
      )
    }
  </div>
</section>
