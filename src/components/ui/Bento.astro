---
/**
 * Bento grid: 4 columns on desktop, 2 on tablets, 1 on phones. Children are
 * usually <Tile>s; span them with `span`/`rows` on the Tile. `stagger` makes
 * the tiles rise in one after another on load.
 */
import type { HTMLAttributes } from "astro/types";

type Props = { stagger?: boolean } & HTMLAttributes<"div">;

const { stagger = true, class: className, ...attrs } = Astro.props;
---

<div
  class:list={[
    "grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4",
    { stagger },
    className,
  ]}
  {...attrs}
>
  <slot />
</div>
