---
import { getRelativeLocaleUrl } from "astro:i18n";
import Arrow from "./ui/Arrow.astro";
import { categoryLabel } from "@/utils/categoryLabel";
import config from "@/config";

type Props = {
  category: string;
  categoryName: string;
  count?: number;
};

const { category, categoryName, count } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

const label = categoryLabel(categoryName);
---

<li class="flex">
  <a
    href={getRelativeLocaleUrl(locale, `categories/${category}/`)}
    transition:name={category}
    class="group bg-surface border-border rounded-tile-sm sm:rounded-tile ease-out-expo hover:shadow-lift flex min-h-36 w-full flex-col justify-between gap-6 border p-5 transition-[translate,box-shadow] duration-400 hover:-translate-y-1 sm:p-6"
  >
    <span class="flex items-start justify-between gap-3">
      {
        typeof count === "number" && (
          <span class="font-display text-4xl leading-none font-extrabold tracking-[-0.04em] tabular-nums">
            {count}
          </span>
        )
      }
      <Arrow class="text-muted-foreground" />
    </span>
    <span class="flex flex-col gap-0.5">
      <span class="font-display text-lg leading-tight font-bold tracking-[-0.015em]">
        {label}
      </span>
      <span class="text-muted-foreground font-mono text-xs">
        {count === 1 ? "post" : "posts"}
      </span>
    </span>
  </a>
</li>
