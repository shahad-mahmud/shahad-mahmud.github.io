---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import TokenChip from "./TokenChip.astro";
import config from "@/config";

type Props = {
  category: string;
  categoryName: string;
  count?: number;
  size?: "sm" | "lg";
};

const { category, categoryName, count, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <TokenChip
    href={getRelativeLocaleUrl(locale, `categories/${category}/`)}
    transition:name={category}
    class:list={[{ "text-sm": size === "lg", "text-[0.7rem]": size === "sm" }]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-3.5": size === "lg" },
        { "size-3": size === "sm" },
      ]}
    />
    {categoryName}
    {typeof count === "number" && <span class="opacity-70">({count})</span>}
  </TokenChip>
</li>
