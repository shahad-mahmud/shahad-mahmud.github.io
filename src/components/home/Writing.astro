---
/**
 * "03 Writing": latest posts as tiles, filterable by top-level category.
 * Filtering is progressive enhancement — without JS every post shows.
 */
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Tile from "@/components/ui/Tile.astro";
import Arrow from "@/components/ui/Arrow.astro";
import { buildPostUrl } from "@/utils/postUrl";
import config from "@/config";

type Props = { posts: CollectionEntry<"posts">[] };

const { posts } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

// "system-design" → "System design"; acronyms stay upper case.
const ACRONYMS = new Set(["ml", "llm", "nlp", "ai"]);
const label = (category: string) =>
  ACRONYMS.has(category)
    ? category.toUpperCase()
    : (category.charAt(0).toUpperCase() + category.slice(1)).replace(/-/g, " ");

const items = posts.map(post => {
  const category = post.data.categories[0] ?? "notes";
  return {
    title: post.data.title,
    href: buildPostUrl({ ...post.data, slug: post.id }),
    date: post.data.pubDatetime.toLocaleDateString("en-GB", {
      month: "short",
      year: "numeric",
      timeZone: post.data.timezone ?? config.site.timezone,
    }),
    category,
  };
});

const categories = [...new Set(items.map(i => i.category))];
---

<section
  id="writing"
  aria-labelledby="writing-title"
  class="flex scroll-mt-6 flex-col gap-5"
>
  <SectionHeading index="03" id="writing-title">
    Writing
    <a
      slot="aside"
      href={getRelativeLocaleUrl(locale, "blogs")}
      class="text-muted-foreground hover:text-foreground text-sm"
    >
      All posts →
    </a>
  </SectionHeading>

  <div
    role="group"
    aria-label="Filter posts by topic"
    class="-mx-4 flex gap-1.5 overflow-x-auto px-4 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:px-0"
  >
    {
      ["all", ...categories].map(category => (
        <button
          data-filter={category}
          aria-pressed={category === "all" ? "true" : "false"}
          class="border-border bg-surface aria-pressed:bg-ink aria-pressed:text-ink-foreground aria-pressed:border-ink min-h-10 shrink-0 rounded-full border px-4 text-sm font-medium transition-colors"
        >
          {category === "all" ? "All" : label(category)}
        </button>
      ))
    }
  </div>

  <ul class="stagger m-0 grid list-none grid-cols-1 gap-3 p-0 sm:gap-4 lg:grid-cols-2">
    {
      items.map(item => (
        <li data-category={item.category} class="flex">
          <Tile
            href={item.href}
            pad="sm"
            class="w-full flex-row items-center justify-between gap-4"
          >
            <span class="flex min-w-0 flex-col gap-1">
              <span class="text-muted-foreground font-mono text-xs">
                {item.date} · {label(item.category)}
              </span>
              <span class="font-display text-lg leading-snug font-bold tracking-[-0.015em] sm:text-xl">
                {item.title}
              </span>
            </span>
            <Arrow circle />
          </Tile>
        </li>
      ))
    }
  </ul>
</section>

<script>
  function setupFilters() {
    const buttons =
      document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const posts = document.querySelectorAll<HTMLElement>("[data-category]");
    buttons.forEach(button =>
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        buttons.forEach(b =>
          b.setAttribute("aria-pressed", String(b === button))
        );
        posts.forEach(post => {
          post.hidden = filter !== "all" && post.dataset.category !== filter;
        });
      })
    );
  }
  document.addEventListener("astro:page-load", setupFilters);
</script>
