---
/** Navy pull-quote tile from a colleague's recommendation, linking to /about. */
import { getRelativeLocaleUrl } from "astro:i18n";
import Bento from "@/components/ui/Bento.astro";
import Tile from "@/components/ui/Tile.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Arrow from "@/components/ui/Arrow.astro";
import { testimonial } from "@/data/profile";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Bento>
  <Tile
    tag="section"
    tone="primary"
    span={4}
    pad="lg"
    aria-label="What colleagues say"
    class="gap-8 sm:flex-row sm:items-end sm:justify-between"
  >
    <figure class="m-0 flex max-w-3xl flex-col gap-5">
      <Eyebrow>What colleagues say</Eyebrow>
      <blockquote
        class="font-display m-0 text-[1.75rem] leading-[1.12] font-bold tracking-[-0.03em] sm:text-[2.25rem]"
      >
        <span aria-hidden="true" class="text-signal">“</span>{
          testimonial.pull
        }<span aria-hidden="true" class="text-signal">”</span>
      </blockquote>
      <figcaption class="text-[15px]">
        <span class="font-semibold">{testimonial.name}</span>
        <span class="opacity-75"> · {testimonial.title}</span>
      </figcaption>
    </figure>
    <a
      href={getRelativeLocaleUrl(locale, "about")}
      class="group flex shrink-0 items-center gap-2 text-[15px] font-semibold underline-offset-4 hover:underline"
    >
      Read the full note <Arrow />
    </a>
  </Tile>
</Bento>
