---
/**
 * Visible "key takeaway" / TL;DR callout for a post.
 *
 * Renders `entry.data.tldr` (a plain string) near the top of the post,
 * above the article body. Renders nothing when `tldr` is absent.
 */
type Props = {
  tldr?: string;
};

const { tldr } = Astro.props;
---

{
  tldr && (
    <section
      aria-label="Key takeaways"
      class="border-accent bg-muted/40 mt-6 mb-8 rounded-md border-l-4 px-4 py-3 sm:px-6 sm:py-4"
    >
      <h2 class="text-muted-foreground mt-0 mb-2 text-sm font-semibold tracking-wide uppercase">
        TL;DR
      </h2>
      <p class="text-foreground mb-0 leading-relaxed whitespace-pre-line">
        {tldr}
      </p>
    </section>
  )
}
